@model BeatStore_SoftUni.ViewModels.BeatDtos.CreateBeatDTO

<h1>Create a Beat</h1>

<link href="https://cdn.jsdelivr.net/npm/select2/dist/css/select2.min.css" rel="stylesheet" />

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="Enter beat title" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GenreIds" class="form-label">Genres</label>
        <select asp-for="GenreIds" class="form-control genre-select" multiple>
            @foreach (var genre in (ViewBag.Genres as IEnumerable<BeatStore_SoftUni.Data.Models.Genre> ?? Enumerable.Empty<BeatStore_SoftUni.Data.Models.Genre>()))
            {
                <option value="@genre.Id">@genre.Name</option>
            }
        </select>
        <span asp-validation-for="GenreIds" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="Set a price" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AudioFileUrl" class="form-label"></label>
        <input asp-for="AudioFileUrl" class="form-control" placeholder="Enter the audio file URL" />
        <span asp-validation-for="AudioFileUrl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CoverArtUrl" class="form-label"></label>
        <input asp-for="CoverArtUrl" class="form-control" placeholder="Enter the cover art URL" />
        <span asp-validation-for="CoverArtUrl" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create Beat</button>
</form>

@section Scripts {
    <!-- jQuery Validation -->
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    <!-- Select2 for Genre Selection -->
    <script src="https://cdn.jsdelivr.net/npm/select2/dist/js/select2.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2/dist/css/select2.min.css" rel="stylesheet" />
    <script>
        $(document).ready(function () {
            $('.genre-select').select2({
                placeholder: "Select genres",
                allowClear: true
            });
        });
    </script>
}
