@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}

@if (ViewBag.ErrorMessage != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Oops...',
            text: '@ViewBag.ErrorMessage'
        });
    </script>
}

@if (ViewBag.SuccessMessage != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: '@ViewBag.SuccessMessage'
        });
    </script>
}
