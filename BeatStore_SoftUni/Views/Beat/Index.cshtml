@model IEnumerable<BeatStore_SoftUni.ViewModels.BeatDtos.BeatIndexDTO>

@section Styles {
    <link rel="stylesheet" href="~/css/beat-library.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
}

@section Scripts {
    <script src="~/js/errorToast.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

@if (TempData["ErrorMessage"] != null)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1055;">
        <div id="error-toast" class="toast align-items-center text-bg-warning border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="fa fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<div class="library-header">
    <h1 class="library-title">Library</h1>
    <a href="@Url.Action("Create", "Beat")" class="upload-button">
        <i class="fa fa-cloud-upload-alt"> Upload Beat</i>
    </a>
</div>

<form method="get" class="mb-4">
    <div class="row align-items-end">
        <!-- Search Bar -->
        <div class="col-md-4">
            <label for="searchQuery" class="form-label">Search Beats</label>
            <input type="text" name="searchQuery" class="form-control" placeholder="Search by title or artist..." value="@ViewBag.SearchQuery" />
        </div>

        <!-- Genre Dropdown -->
        <div class="col-md-4">
            <label for="genreId" class="form-label">Filter by Genre</label>
            <select name="genreId" class="form-select">
                <option value="">All Genres</option>
                @foreach (var genre in (IEnumerable<BeatStore_SoftUni.Data.Models.Genre>)ViewBag.Genres)
                {
                    <option value="@genre.Id" selected="@(ViewBag.SelectedGenreId == genre.Id)">
                        @genre.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label for="sortOption" class="form-label">Sort By</label>
            <select name="sortOption" class="form-select">
                <option value="">Newest First</option>
                <option value="A-Z" selected="@(ViewBag.SortOption == "A-Z")">A - Z</option>
                <option value="Z-A" selected="@(ViewBag.SortOption == "Z-A")">Z - A</option>
            </select>
        </div>

        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100">
                <i class="fa fa-search"></i>
            </button>
        </div>
    </div>
</form>

<div class="library-container">
    @foreach (var beat in Model.Where(b => b.IsActive))
    {
        <div class="library-card"
             data-audio-url="@beat.AudioFileUrl"
             data-title="@beat.Title"
             data-cover="@beat.CoverArtUrl"
             data-artist="@beat.ArtistUsername"
             data-details-url="@Url.Action("Details", "Beat", new { id = beat.Id })">
            <div class="cover-wrapper">
                <a href="@Url.Action("Details", "Beat", new { id = beat.Id })">
                    <img src="@beat.CoverArtUrl" alt="Beat Cover Art">
                </a>
                <div class="play-button">
                    <i class="fa fa-play"></i>
                </div>
            </div>
            <div class="card-body">
                <h5 class="card-title">@beat.Title</h5>
                <p class="card-text">
                    @if (!string.IsNullOrEmpty(beat.Genre))
                    {
                        <strong>Genre:</strong> @beat.Genre<br>
                    }
                    <strong>Price:</strong> $@beat.Price
                </p>
            </div>
        </div>
    }
</div>