@model IEnumerable<BeatStore_SoftUni.ViewModels.BeatDtos.BeatIndexDTO>

@section Styles {
    <link rel="stylesheet" href="~/css/beat-library.css">
}

@section Scripts {
    <script src="~/js/library.js" asp-append-version="true"></script>
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

<h1 class="text-center mt-4 text-white">Library</h1>

<div class="library-container">
    @foreach (var beat in Model)
    {
        <div class="library-card"
             data-audio-url="@beat.AudioFileUrl"
             data-title="@beat.Title"
             data-cover="@beat.CoverArtUrl">
            <div class="cover-wrapper">
                <a href="@Url.Action("Details", "Beat", new { id = beat.Id })">
                    <img src="@beat.CoverArtUrl" alt="Beat Cover Art">
                </a>
                <div class="play-button">
                    <i class="fa fa-play"></i>
                </div>
            </div>
            <div class="card-body">
                <h5 class="card-title">@beat.Title</h5>
                <p class="card-text">
                    <strong>Genre:</strong> @beat.Genre <br>
                    <strong>Price:</strong> $@beat.Price
                </p>
            </div>
        </div>
    }
</div>

<footer id="media-player" class="media-player hidden">
    <div class="player-left">
        <img id="track-cover" src="" alt="Track Cover" class="track-cover">
        <div class="track-info">
            <span id="track-title" class="track-title">No track playing</span>
            <span id="track-artist" class="track-artist">Unknown Artist</span>
        </div>
    </div>
    <div class="player-center">
        <div class="player-controls">
            <button id="prev-button" class="control-button"><i class="fa fa-step-backward"></i></button>
            <button id="play-pause-button" class="control-button"><i class="fa fa-play"></i></button>
            <button id="next-button" class="control-button"><i class="fa fa-step-forward"></i></button>
        </div>
        <div class="progress-container">
            <span id="current-time">0:00</span>
            <input id="progress-bar" type="range" min="0" max="100" value="0">
            <span id="track-duration">0:00</span>
        </div>
    </div>
    <div class="player-right">
        <button id="volume-button" class="control-button"><i class="fa fa-volume-up"></i></button>
        <input id="volume-slider" type="range" min="0" max="1" step="0.1" value="1">
    </div>
</footer>
