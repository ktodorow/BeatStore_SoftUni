@model IEnumerable<BeatStore_SoftUni.Data.Models.Beat>

<h2 class="text-light">Beats</h2>
<p class="text-muted">Browse a list of all available beats.</p>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var beat in Model)
        {
            <div class="col">
                <div class="card bg-dark text-light h-100 shadow">
                    <!-- Cover Art -->
                    <img src="@beat.CoverArtUrl" class="card-img-top" alt="Cover art for @beat.Title" style="height: 200px; object-fit: cover;">
                    
                    <!-- Beat Details -->
                    <div class="card-body">
                        <h5 class="card-title">@beat.Title</h5>
                        <p class="card-text text-muted">
                            <strong>Genre:</strong> @beat.Genre<br />
                            <strong>Artist:</strong> @beat.Artist.UserName<br />
                            <strong>Price:</strong> @beat.Price.ToString("C")
                        </p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="card-footer text-center">
                        <a href="@Url.Action("Details", "Beats", new { id = beat.Id })" class="btn btn-outline-light">Details</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted">No beats available yet!</p>
    }
</div>
